# MCP 服务器配置模板
# 复制为 config/mcp.yaml 后按需修改，每个 key 即服务器名
#
# 完整参数（均为可选，不写走默认值）：
#   type:           stdio / sse / streamableHttp（有 command 自动＝stdio，有 url 自动推断）
#   command:        stdio 启动命令
#   args:           stdio 命令参数
#   env:            stdio 环境变量
#   url:            HTTP 端点 URL
#   headers:        HTTP 自定义请求头
#   enabled_tools:  工具白名单，默认 ["*"] 全部
#   tool_timeout:   单次调用超时秒数，默认 30
#
# 示例：
#
# # 本地 stdio
# time:
#   command: python
#   args: ["-m", "mcp_server_time"]
#
# # 远程 SSE
# remote:
#   type: sse
#   url: https://example.com/mcp/sse
#   headers:
#     Authorization: "Bearer xxx"
#   tool_timeout: 60
